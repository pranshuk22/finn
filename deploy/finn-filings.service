[Unit]
Description=FINN: new filings, results, then read the filings that need it

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/finn
# The lock keeps two refreshes from overlapping.
ExecStart=/usr/bin/flock -w 900 /tmp/finn-refresh.lock /bin/bash -c '/home/ubuntu/.local/bin/uv run --frozen python -m backend.jobs.refresh --only filings --only results --days 3 && /home/ubuntu/.local/bin/uv run --frozen python -m backend.enrich'
