[Unit]
Description=FINN API and app
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/finn
# One worker: ledger build jobs are tracked in process memory (backend/pull.py).
ExecStart=/home/ubuntu/.local/bin/uv run --frozen uvicorn backend.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
