[Unit]
Description=FINN EOD after the close on trading days (twice, Yahoo can lag), and a Saturday catch-up

[Timer]
OnCalendar=Mon..Fri *-*-* 16:45:00 Asia/Kolkata
OnCalendar=Mon..Fri *-*-* 19:30:00 Asia/Kolkata
# Yahoo returned Friday 30 Oct for 15 of 18 tickers on the first try; a later run filled the rest
OnCalendar=Sat *-*-* 09:00:00 Asia/Kolkata

[Install]
WantedBy=timers.target
